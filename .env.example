# Supabase Project Credentials
# Find these in your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Keep secret! Only needed for administrative scripts or server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Website Public URL (Used for metadata, absolute links, and OAuth redirect callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
